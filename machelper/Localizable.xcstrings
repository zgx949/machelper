    "machelper lives in the menu bar at the top of your screen. It does not show a Dock icon." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "machelper lives in the menu bar at the top of your screen. It does not show a Dock icon."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "machelper 常驻屏幕顶部的菜单栏，不会在程序坞显示图标。"
          }
        }
      }
    },
    "machelper needs Accessibility to reverse scrolling, arrange windows and paste clipboard items. Without it, these features cannot run." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "machelper needs Accessibility to reverse scrolling, arrange windows and paste clipboard items. Without it, these features cannot run."
